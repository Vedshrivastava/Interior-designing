PORT=
MONGO_URI=
# Optional — which database on that cluster to use. Leave unset in
# production (Railway): it defaults to "Interior", the live database.
# Set this locally (e.g. to "InteriorDev") to point local development at
# a separate, safe-to-break database on the same cluster instead.
MONGO_DB_NAME=
JWT_SECRET=
JWT_KEY_CONSUMER=
JWT_KEY_ADMIN=

CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Mailtrap Email Sending (production — not sandbox)
# Get this token from: mailtrap.io → Email Sending → SMTP/API Settings → API
MAILTRAP_TOKEN=
# A verified sender email from your domain (verify domain in Mailtrap dashboard first)
MAILTRAP_SENDER_EMAIL=noreply@shrivastavaselevate.com
